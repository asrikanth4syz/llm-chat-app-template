/**
 * Test-only Wrangler config for the vitest worker pool.
 *
 * This mirrors wrangler.jsonc EXCEPT it omits the Workers AI ("ai") binding:
 * the vitest-pool-workers runtime provisions AI via a *remote* proxy session,
 * which requires an interactive `wrangler login` and therefore breaks the
 * offline test run (and CI, which has no login for the test step). The label
 * OCR seam degrades gracefully when env.AI is absent, so tests exercise that
 * fallback. Production deploys use wrangler.jsonc, which keeps the AI binding.
 *
 * Keep binding-affecting keys (d1_databases, vars, assets, compatibility) in
 * sync with wrangler.jsonc.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "llm-chat-app-template",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smart-pantry-db",
			"database_id": "6cd22d64-eaf3-4711-9df9-edca9eb732cd",
			"migrations_dir": "./migrations"
		}
	],
	"vars": {
		"JWT_SECRET": "smart-pantry-dev-secret-change-in-prod",
		"APP_ENV": "development",
		"EMAIL_FROM": "noreply@smartpantry.4syz.com",
		"MAILCHANNELS_ENABLED": "false",
		"ZOHO_BOOKS_ORG_ID": "",
		"ZOHO_BOOKS_CLIENT_ID": "",
		"ZOHO_BOOKS_WEBHOOK_SECRET": "",
		"ZOHO_INVENTORY_ORG_ID": "",
		"ZOHO_ACCESS_TOKEN": "",
		"ZOHO_INVENTORY_WEBHOOK_SECRET": "",
		"TWILIO_ACCOUNT_SID": "",
		"TWILIO_AUTH_TOKEN": "",
		"TWILIO_FROM_NUMBER": "",
		"MSG91_AUTH_KEY": "",
		"OTP_EXPIRY_MINUTES": "5",
		"OTP_ENABLED": "false"
	}
}
