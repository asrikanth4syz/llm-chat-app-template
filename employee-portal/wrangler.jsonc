{
  // 4SYZ Employee Portal — R0 foundation. Separate Worker + D1 from SmartPantry.
  "name": "employee-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "employee-portal-db",
      // Create with: wrangler d1 create employee-portal-db  → paste the id here.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
  // JWT_SECRET is a secret, not a var: set with `wrangler secret put JWT_SECRET`.
}
