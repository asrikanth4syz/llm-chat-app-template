/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smart-pantry",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smart-pantry-db",
			"database_id": "6cd22d64-eaf3-4711-9df9-edca9eb732cd",
			"migrations_dir": "./migrations",
			"remote": true
		}
	],
	"vars": {
		"JWT_SECRET": "smart-pantry-dev-secret-change-in-prod",
		"APP_ENV": "development",
		"EMAIL_FROM": "noreply@smartpantry.4syz.com",
		"MAILCHANNELS_ENABLED": "false",
		"ZOHO_BOOKS_ORG_ID": "",
		"ZOHO_BOOKS_CLIENT_ID": "",
		"ZOHO_BOOKS_WEBHOOK_SECRET": "",
		"TWILIO_ACCOUNT_SID": "",
		"TWILIO_AUTH_TOKEN": "",
		"TWILIO_FROM_NUMBER": "",
		"MSG91_AUTH_KEY": "",
		"OTP_EXPIRY_MINUTES": "5",
		"OTP_ENABLED": "false"
	}
}
