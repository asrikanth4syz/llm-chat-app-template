/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smart-pantry",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	// Workers AI — powers Product Intelligence draft extraction (Phase 2). The
	// extract handler guards on env.AI, so an account without Workers AI still
	// works via the deterministic parser fallback.
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		// Daily delivery reminders: 03:30 UTC = 09:00 IST
		"crons": ["30 3 * * *"]
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smart-pantry-db",
			"database_id": "6cd22d64-eaf3-4711-9df9-edca9eb732cd",
			"migrations_dir": "./migrations"
		}
	],
	// Document storage (#9): create the bucket, then uncomment to move vendor/DC
	// document blobs out of D1 into R2. Unbound is safe — the app falls back to
	// base64-in-D1 automatically (see docPut/docGet in src/index.ts).
	//   wrangler r2 bucket create smart-pantry-docs
	// "r2_buckets": [
	//   { "binding": "DOCS", "bucket_name": "smart-pantry-docs" }
	// ],
	"vars": {
		// DEV/TEST ONLY. Production MUST override this with a real secret:
		//   wrangler secret put JWT_SECRET   (a secret overrides this var at runtime)
		// With APP_ENV=production the Worker refuses to serve if JWT_SECRET is
		// missing, this default, or shorter than 32 chars (see insecureSecret()).
		// Also set as secrets for production: BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD.
		"JWT_SECRET": "smart-pantry-dev-secret-change-in-prod",
		"APP_ENV": "development",
		"EMAIL_FROM": "noreply@smartpantry.4syz.com",
		"MAILCHANNELS_ENABLED": "false",
		"ZOHO_BOOKS_ORG_ID": "",
		"ZOHO_BOOKS_CLIENT_ID": "",
		"ZOHO_BOOKS_WEBHOOK_SECRET": "",
		"ZOHO_INVENTORY_ORG_ID": "",
		"ZOHO_ACCESS_TOKEN": "",
		"ZOHO_INVENTORY_WEBHOOK_SECRET": "",
		"TWILIO_ACCOUNT_SID": "",
		"TWILIO_AUTH_TOKEN": "",
		"TWILIO_FROM_NUMBER": "",
		"MSG91_AUTH_KEY": "",
		"OTP_EXPIRY_MINUTES": "5",
		"OTP_ENABLED": "false"
	}
}
